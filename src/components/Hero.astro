---
// Hero: full name, one-line positioning, and the two anchor CTAs.
import { profile } from '../data/profile';
---

<section id="hero" class="hero reveal">
  <div class="container">
    <p class="section-kicker mono">{profile.role} → Automatización industrial</p>
    <h1 class="hero-name">{profile.fullName}</h1>
    <p class="hero-lede">
      Estadística de la Universidad Nacional de Colombia: llevo el análisis cuantitativo y el
      modelamiento estadístico al mundo de la automatización industrial.
    </p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href="#projects">Ver proyectos</a>
      <a class="btn btn-ghost" href="#contact">Contacto</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .hero-name {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-s);
  }

  .hero-lede {
    color: var(--muted);
    font-size: var(--text-lg);
    max-width: var(--measure);
    margin-bottom: var(--space-l);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
</style>
