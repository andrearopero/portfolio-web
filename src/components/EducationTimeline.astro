---
// Education timeline fed by the `education` collection.
// "En curso" badge (mono) for current entries; institution line omitted for
// them entirely — the schema already forbids unconfirmed facts.
import { getCollection } from 'astro:content';

const entries = (await getCollection('education')).sort((a, b) => {
  // Order: current degree first, then completed degrees (newest period),
  // then training badges (newest period).
  const group = (kind: string) => (kind === 'degree' ? 0 : 1);
  const current = (status: string) => (status === 'current' ? 0 : 1);
  const year = (period?: string) => Number(period?.match(/\d{4}/)?.[0] ?? 0);
  return (
    group(a.data.kind) - group(b.data.kind) ||
    current(a.data.status) - current(b.data.status) ||
    year(b.data.period) - year(a.data.period) ||
    String(b.data.period ?? '').localeCompare(String(a.data.period ?? ''), 'es')
  );
});
---

<section id="education" class="section reveal">
  <div class="container">
    <p class="section-kicker mono">04 / Formación</p>
    <h2 class="section-title">Trayectoria académica</h2>
    <ol class="timeline">
      {
        entries.map((entry) => (
          <li class="timeline-item">
            <div class="card timeline-card">
              <div class="timeline-head">
                <h3>{entry.data.title}</h3>
                {entry.data.status === 'current' ? (
                  <span class="mono status-badge">En curso</span>
                ) : (
                  <span class="mono period">{entry.data.period}</span>
                )}
              </div>
              {entry.data.status === 'completed' && entry.data.institution && (
                <p class="institution">{entry.data.institution}</p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
    border-inline-start: 2px solid var(--border);
  }

  .timeline-item {
    position: relative;
    padding-inline-start: var(--space-l);
    padding-block-end: var(--space-s);
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    inset-block-start: 1.4rem;
    inset-inline-start: -6px;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--accent);
  }

  .timeline-card {
    padding: var(--space-s) var(--space-m);
  }

  .timeline-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3xs) var(--space-s);
  }

  .timeline-head h3 {
    font-size: var(--text-md);
  }

  .status-badge,
  .period {
    color: var(--accent);
    white-space: nowrap;
  }

  .institution {
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>
