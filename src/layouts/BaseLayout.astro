---
import '../styles/global.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-700.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';

interface Props {
  title?: string;
  description?: string;
}

const fullName = 'Andrea Carolina Ropero Lozano';

const {
  title = `${fullName} — Estadística · Automatización Industrial`,
  description = `${fullName}, estadística de la Universidad Nacional de Colombia: análisis cuantitativo, modelamiento estadístico y datos aplicados a la automatización industrial.`,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // No-FOUC theme bootstrap: resolves the theme pre-paint, before any
      // render. Stored choice wins; otherwise honor prefers-color-scheme.
      (() => {
        const root = document.documentElement;
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {
          // Storage unavailable (e.g. hardened privacy settings) — fall through.
        }
        const dark =
          stored === 'dark' ||
          (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        root.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>

    <slot />

    <script>
      // Theme toggle: flips data-theme and persists the explicit choice.
      const toggle = document.querySelector('[data-theme-toggle]');
      toggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          // Persistence is best-effort; the visual flip already happened.
        }
      });

      // Scroll reveal: quick fade-up as sections enter the viewport. The
      // hidden pre-reveal state only applies once the document is armed here,
      // so a JS failure can never leave content invisible.
      const revealEls = document.querySelectorAll('.reveal');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reducedMotion && 'IntersectionObserver' in window && revealEls.length > 0) {
        document.documentElement.dataset.revealArmed = '';
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
        );
        revealEls.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
