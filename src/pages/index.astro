---
// Single anchored page: seven sections in fixed order (portfolio-page spec).
// Adding content happens through the collections — never by editing this file.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import EducationTimeline from '../components/EducationTimeline.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main id="main">
    <Hero />
    <About />
    <Skills />
    <EducationTimeline />
    <ProjectGrid />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
